# Market data provider: csv, alpha_vantage, or router.
DATA_PROVIDER=router
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
ASSET_SYMBOLS=AAPL,MSFT,NVDA,TSLA,AMZN
SCAN_SYMBOLS=AAPL,MSFT,NVDA,TSLA,AMZN
ASSET_TYPES=AAPL:stock,MSFT:stock,NVDA:stock,TSLA:stock,AMZN:stock
MARKET_TIMEFRAME=5min
MAX_SYMBOLS_PER_SCAN=5
API_REQUEST_DELAY=12
DATA_CACHE_MINUTES=15
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
YFINANCE_ENABLED=true
BINANCE_BASE_URL=https://api.binance.com
ALPHA_VANTAGE_TEST_SYMBOL=AAPL
ALPHA_VANTAGE_TEST_TIMEFRAME=daily

# Paths are relative to market_bot/ unless absolute.
MARKET_CSV_PATH=data/market_prices.csv
MARKET_DATABASE_PATH=data/market_bot.sqlite3
MARKET_REPORT_DIR=reports

# Simple moving-average crossover settings.
MARKET_FAST_WINDOW=5
MARKET_SLOW_WINDOW=20
MARKET_PAPER_HOLD_BARS=5
MARKET_MAX_DATA_AGE_MINUTES=180

# Loop cadence.
MARKET_SIGNAL_INTERVAL_SECONDS=60
MARKET_PERFORMANCE_INTERVAL_SECONDS=300
MARKET_REPORT_INTERVAL_SECONDS=3600

# Monitoring only warns after enough completed paper predictions.
MARKET_MONITOR_MIN_PREDICTIONS=20
MARKET_MONITOR_MIN_HIT_RATE=0.45

# Optional; validated signals are logged (not sent) unless both are set.
MARKET_TELEGRAM_BOT_TOKEN=
MARKET_TELEGRAM_CHAT_ID=
